# ==============================================================================
# MindPilot AI - Environment Configuration
# ==============================================================================

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
GCP_BIGQUERY_DATASET=mindpilot_analytics
GCP_STORAGE_BUCKET=your-gcp-project-id-mindpilot-assets
GCP_PUBSUB_TOPIC_TELEMETRY=mindpilot-telemetry-events
GCP_PUBSUB_TOPIC_CRISIS=mindpilot-crisis-alerts
GCP_PUBSUB_TOPIC_ENVIRONMENT=mindpilot-environmental-alerts

# Google Cloud Service Account Authentication (Optional for local development)
# When deploying to Cloud Run, credentials are automatically resolved via GCP Workload Identity / Metadata Server.
# For local development with live GCP services:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional Gemini API Key fallback (used when running outside GCP without ADC)
# GEMINI_API_KEY=your_gemini_api_key_here

# Earth Engine Service Account Email & Private Key (Optional)
# EARTH_ENGINE_CLIENT_EMAIL=earth-engine-sa@your-gcp-project.iam.gserviceaccount.com
# EARTH_ENGINE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Port Configuration (Defaults to 8080 for Cloud Run compatibility)
PORT=8080
NODE_ENV=production
